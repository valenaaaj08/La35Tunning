<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuente en NEGRITA para La35Tunning (agregada para mejorar la interfaz).
  Usa la misma "Arial" que FuentePrincipal, que viene instalada en Windows.
  Tiene las mismas regiones de caracteres (incluye tildes, ñ, ¡ y ¿).
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>40</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#161;</Start>
        <End>&#255;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
